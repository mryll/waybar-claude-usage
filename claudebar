#!/usr/bin/env bash
# claudebar — Claude AI plan usage widget for Waybar
# Reads OAuth credentials from Claude CLI, shows session/weekly limits
# with colored progress bars and Pango markup tooltip.
#
# Usage: claudebar [--help] [--icon ICON] [--format FORMAT] [--tooltip-format FORMAT]
#                  [--pace-tolerance N] [--format-pace-color] [--tooltip-pace-pts] [--remaining]
#                  [--frame] [--frame-font FONT] [--no-color[=all|bar|tooltip]]
#                  [--color-low HEX] [--color-mid HEX] [--color-high HEX] [--color-critical HEX]
#                  [--json] [--refresh]
#
# --help     Print this reference — usage, flags and format placeholders — and
#            exit 0. Also accepted as -h.
# --json     Structured output mode: emits one raw-data JSON object (numbers,
#            ISO-8601 timestamps, state strings — no Pango markup) instead of
#            Waybar JSON. For frontends that render their own UI, e.g. the
#            Omarchy shell plugin in omarchy/. Always exits 0; errors are
#            reported in an "error" field. Carries the resolved gauge anchors
#            in "palette" (theme colors / --color-* overrides) so such a
#            frontend paints the same ramp this script does — the only colors
#            in the payload, and data rather than markup.
#            See README "Structured JSON output".
# --refresh  Bypass the 60s response cache and fetch fresh data from the API
#            (the result still updates the cache for other instances).
# --frame    Draw the tooltip as a bordered card instead of plain text. The box
#            is built from Nerd Font glyphs; --frame-font FONT names the font
#            Pango uses for them when the Waybar font has no box drawing.
# --no-color[=all|bar|tooltip]
#            Monochrome output: no color markup on the chosen surface (default
#            "all"). Everything structural stays — glyphs, bar characters,
#            markers, box drawing, bold, layout. The "class" field and the
#            --json payload are unaffected, so CSS remains the way to style a
#            monochrome bar. NO_COLOR=<non-empty> in the environment means
#            --no-color=all; an explicit flag wins over it.
#
# Format placeholders:
#   {icon}              Widget mark, Nerd Font (󰚩)
#   {plan}              Plan label (e.g. "Max 5x")
#   {session_pct}       Session (5h) usage %
#   {session_reset}     Session countdown (e.g. "1h 30m")
#   {session_elapsed}   Session time elapsed % (e.g. "58")
#   {session_bar}       Session usage progress bar (Pango-colored)
#   {session_pace}           Session pacing icon, ratio-based (↑ ↓ →)
#   {session_pace_indicator} Session pacing icon, point-based (↑ ↓ →)
#   {session_pace_pct}       Session pacing deviation, ratio (e.g. "72% ahead")
#   {session_pace_pts}       Session pacing deviation, points (e.g. "12pts ahead")
#   {session_pace_delta}     Session pacing delta, signed (e.g. "-12", "5", "0")
#   {session_pace_abs_delta} Session pacing delta, unsigned (e.g. "12", "5", "0")
#   {weekly_pct}        Weekly (7d all models) usage %
#   {weekly_reset}      Weekly countdown (e.g. "4d 1h")
#   {weekly_elapsed}    Weekly time elapsed % (e.g. "42")
#   {weekly_bar}        Weekly usage progress bar (Pango-colored)
#   {weekly_pace}            Weekly pacing icon, ratio-based (↑ ↓ →)
#   {weekly_pace_indicator}  Weekly pacing icon, point-based (↑ ↓ →)
#   {weekly_pace_pct}        Weekly pacing deviation, ratio (e.g. "72% ahead")
#   {weekly_pace_pts}        Weekly pacing deviation, points (e.g. "12pts ahead")
#   {weekly_pace_delta}      Weekly pacing delta, signed (e.g. "-12", "5", "0")
#   {weekly_pace_abs_delta}  Weekly pacing delta, unsigned (e.g. "12", "5", "0")
#   {sonnet_pct}        Sonnet-only weekly usage %
#   {sonnet_reset}      Sonnet countdown
#   {sonnet_elapsed}    Sonnet time elapsed % (e.g. "42")
#   {sonnet_bar}        Sonnet usage progress bar (Pango-colored)
#   {sonnet_pace}            Sonnet pacing icon, ratio-based (↑ ↓ →)
#   {sonnet_pace_indicator}  Sonnet pacing icon, point-based (↑ ↓ →)
#   {sonnet_pace_pct}        Sonnet pacing deviation, ratio (e.g. "72% ahead")
#   {sonnet_pace_pts}        Sonnet pacing deviation, points (e.g. "8pts ahead")
#   {sonnet_pace_delta}      Sonnet pacing delta, signed (e.g. "-8", "3", "0")
#   {sonnet_pace_abs_delta}  Sonnet pacing delta, unsigned (e.g. "8", "3", "0")
#   {model_name}        Model-scoped weekly limit model name (e.g. "Fable").
#                       With several model-scoped limits, {model_*} tracks the
#                       first one; the tooltip shows one section per model.
#   {model_pct}         Model-scoped weekly usage %
#   {model_reset}       Model countdown
#   {model_elapsed}     Model time elapsed % (e.g. "42")
#   {model_bar}         Model usage progress bar (Pango-colored)
#   {model_pace}             Model pacing icon, ratio-based (↑ ↓ →)
#   {model_pace_indicator}   Model pacing icon, point-based (↑ ↓ →)
#   {model_pace_pct}         Model pacing deviation, ratio (e.g. "72% ahead")
#   {model_pace_pts}         Model pacing deviation, points (e.g. "8pts ahead")
#   {model_pace_delta}       Model pacing delta, signed (e.g. "-8", "3", "0")
#   {model_pace_abs_delta}   Model pacing delta, unsigned (e.g. "8", "3", "0")
#   {extra_spent}       Extra usage spent (e.g. "$2.50")
#   {extra_limit}       Extra usage monthly limit (e.g. "$50.00")
#   {extra_pct}         Usage-credit spend as % of real funded credits
#   {extra_bar}         Real funded-credit progress bar (Pango-colored)
#
#   Remaining mode (battery framing; available regardless of --remaining):
#   {session_remaining_pct}   Session remaining % (100 - used)
#   {session_remaining_bar}   Session remaining drain bar (Pango, no marker)
#   {weekly_remaining_pct}    Weekly remaining %
#   {weekly_remaining_bar}    Weekly remaining drain bar
#   {sonnet_remaining_pct}    Sonnet remaining %
#   {sonnet_remaining_bar}    Sonnet remaining drain bar
#   {model_remaining_pct}     Model-scoped remaining %
#   {model_remaining_bar}     Model-scoped remaining drain bar
#
# Default format: "{session_pct}% · {session_reset}"
# Note: bar placeholders are colored by their own window's usage, independent of
#       the surrounding bar text color (which reflects the worst window).
# --remaining flips the default bar text + tooltip to a "what's left" framing
#   (e.g. "58% · 1h 30m"); {*_remaining_pct} and {*_remaining_bar} are
#   available regardless of this flag. Fully backward compatible; opt-in.

set -euo pipefail

# --- Parse args ---
FORMAT="{session_pct}% · {session_reset}"
TOOLTIP_FORMAT=""
PACE_TOLERANCE=5
REMAINING=false
FORMAT_SET=false
BAR_COLOR_LOW=""
BAR_COLOR_MID=""
BAR_COLOR_HIGH=""
BAR_COLOR_CRITICAL=""
BAR_ICON=""
FORMAT_PACE_COLOR=false
TOOLTIP_PACE_PTS=false
FRAME=false
FRAME_FONT="JetBrainsMono Nerd Font Mono"
JSON_MODE=false
FORCE_REFRESH=false
NO_COLOR_SET=false
NO_COLOR_WHAT=""

# Pre-scan for --json BEFORE the parse loop so argument errors already know
# which output schema to speak. Never reset afterwards.
for _a in "$@"; do [[ "$_a" == "--json" ]] && JSON_MODE=true && break; done

# Argument/usage error. Fires before dependencies are verified, so the JSON
# path needs a jq-less fallback — a FIXED literal (no interpolation, no manual
# escaper) that nothing in the message can break. With jq available the real
# message goes through --arg, which handles quotes and control characters.
# The Waybar shape reproduces the pre-existing inline output byte-for-byte.
cli_error() {
    if [[ "$JSON_MODE" == "true" ]]; then
        if command -v jq &>/dev/null; then
            jq -nc --arg m "$1" '{schema_version:1, error:{message:$m}}'
        else
            printf '{"schema_version":1,"error":{"message":"invalid arguments"}}\n'
        fi
    else
        local _m="${1//\\/\\\\}"; _m="${_m//\"/\\\"}"
        printf '{"text":"⚠","tooltip":"%s","class":"critical"}\n' "$_m"
    fi
    exit 0
}

# Accept the hex forms a color source may legitimately use: #rgb, #rgba,
# #rrggbb, #rrggbbaa. Anything else (color names, gradients, junk) is rejected
# so a malformed theme or pywal cache can never reach the blending math.
is_hex_color() {
    [[ "$1" =~ ^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$ ]]
}

# Reduce any accepted hex form to #rrggbb: shorthand is expanded, alpha is
# dropped (the widget composites on the bar's own background). Prints nothing
# and returns 1 for values is_hex_color would reject, so callers can guard.
normalize_hex() {
    local h="${1#\#}"
    case "${#h}" in
        3|4) printf '#%s%s%s%s%s%s' "${h:0:1}" "${h:0:1}" "${h:1:1}" "${h:1:1}" "${h:2:1}" "${h:2:1}" ;;
        6|8) printf '#%s' "${h:0:6}" ;;
        *)   return 1 ;;
    esac
    return 0
}

# A --color-* value is interpolated into a single-quoted Pango attribute, so it
# must not be able to close that quote or open a tag. Hex passes; so does a bare
# Pango/X11 color name ("red", "tomato"), which the flag has always accepted.
# Anything else is an argument error rather than injected markup.
valid_color_spec() {
    is_hex_color "$1" || [[ "$1" =~ ^[A-Za-z][A-Za-z0-9]*$ ]]
}

# --help / -h: the reference the user needs is already the header comment of
# this file, so print that rather than a second copy that can drift from it.
# The block runs from the "# Usage:" line to the first line that is not a
# comment, with the leading "# " stripped. Plain text on stdout, exit 0 —
# --json does not apply: a human asked.
show_help() {
    awk '/^# Usage:/ { p = 1 }
         p && !/^#/  { exit }
         p           { sub(/^#( |$)/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) show_help ;;
        --icon)
            [[ $# -ge 2 ]] || cli_error "--icon requires a value"
            BAR_ICON="$2"; shift 2 ;;
        --format)
            [[ $# -ge 2 ]] || cli_error "--format requires a value"
            FORMAT="$2"; FORMAT_SET=true; shift 2 ;;
        --tooltip-format)
            [[ $# -ge 2 ]] || cli_error "--tooltip-format requires a value"
            TOOLTIP_FORMAT="$2"; shift 2 ;;
        --pace-tolerance)
            [[ $# -ge 2 ]] || cli_error "--pace-tolerance requires a value"
            PACE_TOLERANCE="$2"; shift 2 ;;
        --format-pace-color) FORMAT_PACE_COLOR=true; shift ;;
        --tooltip-pace-pts) TOOLTIP_PACE_PTS=true; shift ;;
        --remaining) REMAINING=true; shift ;;
        --json) shift ;;  # already picked up by the pre-scan
        --refresh) FORCE_REFRESH=true; shift ;;
        --no-color) NO_COLOR_SET=true; NO_COLOR_WHAT="all"; shift ;;
        --no-color=*)
            NO_COLOR_SET=true; NO_COLOR_WHAT="${1#*=}"
            case "$NO_COLOR_WHAT" in
                all|bar|tooltip) ;;
                *) cli_error "--no-color must be all, bar, or tooltip" ;;
            esac
            shift ;;
        --frame) FRAME=true; shift ;;
        --frame-font) [[ $# -ge 2 ]] || cli_error "--frame-font requires a value"
                      FRAME_FONT="$2"; shift 2 ;;
        --color-low)       [[ $# -ge 2 ]] || cli_error "--color-low requires a value"
                           valid_color_spec "$2" || cli_error "--color-low must be a hex color (#RGB/#RRGGBB) or a color name"
                           BAR_COLOR_LOW="$2"; shift 2 ;;
        --color-mid)       [[ $# -ge 2 ]] || cli_error "--color-mid requires a value"
                           valid_color_spec "$2" || cli_error "--color-mid must be a hex color (#RGB/#RRGGBB) or a color name"
                           BAR_COLOR_MID="$2"; shift 2 ;;
        --color-high)      [[ $# -ge 2 ]] || cli_error "--color-high requires a value"
                           valid_color_spec "$2" || cli_error "--color-high must be a hex color (#RGB/#RRGGBB) or a color name"
                           BAR_COLOR_HIGH="$2"; shift 2 ;;
        --color-critical)  [[ $# -ge 2 ]] || cli_error "--color-critical requires a value"
                           valid_color_spec "$2" || cli_error "--color-critical must be a hex color (#RGB/#RRGGBB) or a color name"
                           BAR_COLOR_CRITICAL="$2"; shift 2 ;;
        *) cli_error "Unknown option: $1" ;;
    esac
done
[[ "$PACE_TOLERANCE" =~ ^[0-9]+$ ]] || cli_error "--pace-tolerance must be a non-negative integer"

# Monochrome mode. NO_COLOR (https://no-color.org) means "all" when set to any
# non-empty value; an explicit --no-color=... is the more specific instruction
# and wins over it, so `NO_COLOR=1 claudebar --no-color=bar` still colors the
# tooltip. Only presentation is affected: the Waybar `class` field and the
# --json payload are machine contracts and stay exactly as they are.
if [[ "$NO_COLOR_SET" != "true" && -n "${NO_COLOR:-}" ]]; then
    NO_COLOR_WHAT="all"
fi
BAR_PLAIN=false
TOOLTIP_PLAIN=false
case "$NO_COLOR_WHAT" in
    all)     BAR_PLAIN=true; TOOLTIP_PLAIN=true ;;
    bar)     BAR_PLAIN=true ;;
    tooltip) TOOLTIP_PLAIN=true ;;
esac
PACE_TOLERANCE=$((10#$PACE_TOLERANCE))
# In remaining mode, default the bar to "what's left" unless the user set their own format.
[[ "$REMAINING" == "true" && "$FORMAT_SET" == "false" ]] && FORMAT="{session_remaining_pct}% · {session_reset}"

CREDS="$HOME/.claude/.credentials.json"
API_URL="https://api.anthropic.com/api/oauth/usage"
API_BASE_URL="https://api.anthropic.com"
TOKEN_URL="https://platform.claude.com/v1/oauth/token"
CLIENT_ID="9d1c250a-e61b-44d9-88ed-5944d1962f5e" # Claude CLI OAuth client ID
REFRESH_BUFFER=300 # refresh 5 min before expiry
CACHE_DIR="$HOME/.cache/claudebar"
CACHE_TTL=60 # seconds

# Transient (no-HTTP-response) failures retry on a deadline budget, not a fixed
# attempt count. Boot-like starts (no cache, or cache older than
# NET_BOOT_CACHE_AGE) poll up to NET_LONG_BUDGET seconds: at the first Waybar
# exec there is nothing better to show than an empty module, and on re-execs
# the bar keeps the previous output while we wait — waiting beats rendering
# day-old data for a full interval. Mid-session blips keep the quick budget.
# CLAUDEBAR_TEST_NET_* envs let the test suite shrink the budgets; they are
# not a user interface.
_env_uint() { if [[ "$1" =~ ^[0-9]+$ ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
NET_RETRY_DELAY=$(_env_uint "${CLAUDEBAR_TEST_NET_RETRY_DELAY:-}" 2)
NET_QUICK_BUDGET=$(_env_uint "${CLAUDEBAR_TEST_NET_QUICK_BUDGET:-}" 6)
NET_LONG_BUDGET=$(_env_uint "${CLAUDEBAR_TEST_NET_LONG_BUDGET:-}" 20)
NET_BOOT_CACHE_AGE=600 # cache older than this → boot-like start
NET_WAIT_RECENT=45     # .net_wait younger than this → a sibling already waited

# --- Theme colors ---

# Blend two hex colors (#RRGGBB) by averaging their RGB components
hex_blend() {
    local c1="${1#\#}" c2="${2#\#}"
    local r1=$((16#${c1:0:2})) g1=$((16#${c1:2:2})) b1=$((16#${c1:4:2}))
    local r2=$((16#${c2:0:2})) g2=$((16#${c2:2:2})) b2=$((16#${c2:4:2}))
    printf '#%02x%02x%02x' $(( (r1+r2)/2 )) $(( (g1+g2)/2 )) $(( (b1+b2)/2 ))
}

# Linear interpolation between two #RRGGBB colors; t in integer thousandths
# (0..1000). Integer math only, components stay within the endpoints.
hex_lerp() {
    local c1="${1#\#}" c2="${2#\#}" t=$3
    local r1=$((16#${c1:0:2})) g1=$((16#${c1:2:2})) b1=$((16#${c1:4:2}))
    local r2=$((16#${c2:0:2})) g2=$((16#${c2:2:2})) b2=$((16#${c2:4:2}))
    printf '#%02x%02x%02x' \
        $(( r1 + (r2 - r1) * t / 1000 )) \
        $(( g1 + (g2 - g1) * t / 1000 )) \
        $(( b1 + (b2 - b1) * t / 1000 ))
}

# Assign a validated, normalized color to a variable by name. Silently keeps
# the variable's current value when the candidate isn't a usable hex color —
# that is the "missing key keeps the built-in default" rule, applied uniformly
# to every color source.
set_color_var() {  # <var-name> <candidate>
    local _norm
    is_hex_color "${2:-}" || return 0
    _norm=$(normalize_hex "$2") || return 0
    printf -v "$1" '%s' "$_norm"
    return 0
}

# Try each candidate in order and keep the first that is a usable color, so a
# malformed value never suppresses a valid fallback behind it.
set_color_var_first() {  # <var-name> <candidate>...
    local var="$1"; shift
    local c
    for c in "$@"; do
        [[ -n "$c" ]] || continue
        is_hex_color "$c" || continue
        set_color_var "$var" "$c"
        return 0
    done
    return 0
}

# Which source painted the palette: "omarchy", "pywal", or "" for built-ins.
# pywal is consulted only when no Omarchy theme was found; it never overrides
# Omarchy, and neither overrides explicit --color-* flags (applied later).
THEME_SOURCE=""

# Locate the active Omarchy theme's colors.toml. Current Omarchy keeps the
# `current/theme` symlink under $XDG_STATE_HOME (what the shell's Color.qml
# reads); older layouts kept it under ~/.config. Try both, newest first, so
# theming works on either without the user configuring anything.
theme_colors_file() {
    local p
    for p in "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml" \
             "$HOME/.config/omarchy/current/theme/colors.toml"; do
        [[ -f "$p" ]] && { printf '%s' "$p"; return 0; }
    done
    # No theme installed (plain Waybar user): print nothing, and exit 0 —
    # a non-zero status here would abort the whole script under `set -e`.
    return 0
}

load_theme_colors() {
    local theme_file
    theme_file=$(theme_colors_file)
    if [[ -n "$theme_file" && -f "$theme_file" ]]; then
        local accent="" foreground="" background=""
        local color1="" color2="" color3=""
        local t_red="" t_green="" t_yellow="" t_orange=""
        # `|| [[ -n "$line" ]]` so a file whose last line has no trailing
        # newline still contributes its final key.
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Skip comments and empty lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${line// /}" ]] && continue
            # Parse key = "value"
            if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]]; then
                local key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
                case "$key" in
                    accent)     accent="$val" ;;
                    foreground) foreground="$val" ;;
                    background) background="$val" ;;
                    # Named keys, as current Omarchy themes ship them.
                    red)        t_red="$val" ;;
                    green)      t_green="$val" ;;
                    yellow)     t_yellow="$val" ;;
                    orange)     t_orange="$val" ;;
                    # Legacy terminal-palette keys.
                    color1)     color1="$val" ;;
                    color2)     color2="$val" ;;
                    color3)     color3="$val" ;;
                esac
            fi
        done < "$theme_file"
        # Map theme colors to widget colors. Named keys win; the color1/2/3
        # fallbacks keep older themes working exactly as before (where color1
        # stood in for both red and orange).
        set_color_var BLUE "$accent"
        set_color_var FG   "$foreground"
        # Candidates in priority order, and the FIRST USABLE one wins: a theme
        # whose semantic key is malformed still gets its legacy color1/2/3
        # honored, instead of the bad value shadowing the good one.
        set_color_var_first RED    "$t_red" "$color1"
        set_color_var_first ORANGE "$t_orange" "$t_red" "$color1"
        set_color_var_first GREEN  "$t_green" "$color2"
        set_color_var_first YELLOW "$t_yellow" "$color3"
        apply_surface_colors "$foreground" "$background"
        THEME_SOURCE="omarchy"
    fi
    return 0
}

# DIM / MARKER / BAR_EMPTY are derived the same way from every color source.
apply_surface_colors() {  # <foreground> <background>
    local fg bg
    fg=$(normalize_hex "${1:-}" 2>/dev/null) || fg=""
    bg=$(normalize_hex "${2:-}" 2>/dev/null) || bg=""
    is_hex_color "${1:-}" || fg=""
    is_hex_color "${2:-}" || bg=""
    # DIM = midpoint between foreground and background
    [[ -n "$fg" && -n "$bg" ]] && DIM=$(hex_blend "$fg" "$bg")
    MARKER="$FG"
    # BAR_EMPTY = slightly lighter than background (blend bg with dim)
    [[ -n "$bg" ]] && BAR_EMPTY=$(hex_blend "$bg" "$DIM")
    return 0
}

# pywal-compatible palette, consulted ONLY when no Omarchy theme was found.
# ${XDG_CACHE_HOME:-~/.cache}/wal/colors.json is the de-facto standard path:
# the original pywal is archived, but the maintained pywal16 fork writes the
# same file and wallust ships a pywal-compat target to it, so this one path
# covers all three. Missing file, unreadable file, or invalid JSON degrades
# silently to the built-in defaults — this function always returns 0.
load_pywal_colors() {
    [[ -z "$THEME_SOURCE" ]] || return 0
    command -v jq &>/dev/null || return 0

    local wal_file="${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.json"
    [[ -f "$wal_file" && -r "$wal_file" ]] || return 0

    # One pass, one value per line; `| strings` drops non-string values. Line
    # separated rather than @tsv on purpose: a tab is IFS whitespace, so `read`
    # would collapse runs of them and silently shift every value after a key the
    # palette happens to omit. A parse failure yields no lines, and the count
    # check below then leaves every field at its default.
    local _pw=()
    readarray -t _pw < <(jq -r '
        ((.special.foreground | strings) // ""),
        ((.special.background | strings) // ""),
        ((.special.cursor     | strings) // ""),
        ((.colors.color1      | strings) // ""),
        ((.colors.color2      | strings) // ""),
        ((.colors.color3      | strings) // ""),
        ((.colors.color4      | strings) // "")' "$wal_file" 2>/dev/null) || true
    (( ${#_pw[@]} == 7 )) || return 0

    local pw_fg="${_pw[0]}" pw_bg="${_pw[1]}" pw_cursor="${_pw[2]}"
    local pw_c1="${_pw[3]}" pw_c2="${_pw[4]}" pw_c3="${_pw[5]}" pw_c4="${_pw[6]}"

    set_color_var FG     "$pw_fg"
    set_color_var RED    "$pw_c1"
    set_color_var GREEN  "$pw_c2"
    set_color_var YELLOW "$pw_c3"
    # accent: color4, or the cursor color when the palette omits it.
    set_color_var BLUE   "${pw_c4:-$pw_cursor}"

    # pywal has no orange slot. Synthesize it as the midpoint of yellow and red
    # so the gauge keeps four distinct steps; aliasing it to red would flatten
    # the 75-90% segment into one flat block.
    local o_y o_r
    if o_y=$(normalize_hex "$YELLOW" 2>/dev/null) && o_r=$(normalize_hex "$RED" 2>/dev/null); then
        ORANGE=$(hex_blend "$o_y" "$o_r")
    fi

    apply_surface_colors "$pw_fg" "$pw_bg"
    THEME_SOURCE="pywal"
    return 0
}

# One Dark defaults (overridden by Omarchy theme if available)
GREEN="#98c379"
YELLOW="#e5c07b"
ORANGE="#d19a66"
RED="#e06c75"
BLUE="#61afef"
DIM="#5c6370"
FG="#abb2bf"
BAR_EMPTY="#3e4451"
MARKER="$FG"
# Resolution chain: --color-* flags (applied below) > Omarchy theme > pywal
# cache > these built-ins. Each loader is a no-op when the previous one already
# supplied a palette, and every one of them returns 0 so `set -e` can't trip.
load_theme_colors
load_pywal_colors

# Bar text colors: CLI overrides > theme/pywal > One Dark defaults
[[ -n "$BAR_COLOR_LOW" ]]      || BAR_COLOR_LOW="$GREEN"
[[ -n "$BAR_COLOR_MID" ]]      || BAR_COLOR_MID="$YELLOW"
[[ -n "$BAR_COLOR_HIGH" ]]     || BAR_COLOR_HIGH="$ORANGE"
[[ -n "$BAR_COLOR_CRITICAL" ]] || BAR_COLOR_CRITICAL="$RED"

# The gradient math needs 6-digit hex, but --color-* has always accepted any
# Pango color spec, including names like "red". Normalize the anchors we can;
# if any of them isn't hex, fall back to discrete steps so a named color keeps
# rendering exactly as it did before the gradient existed, instead of feeding
# "16#re" to the arithmetic and killing the script under `set -e`.
GRADIENT_OK=true
for _anchor in BAR_COLOR_LOW BAR_COLOR_MID BAR_COLOR_HIGH BAR_COLOR_CRITICAL; do
    if is_hex_color "${!_anchor}"; then
        printf -v "$_anchor" '%s' "$(normalize_hex "${!_anchor}")"
    else
        GRADIENT_OK=false
    fi
done

# --- The gauge ---
# One definition of the ramp: the percentages at which it turns, the severity
# state each band carries, and the color anchored at each turn once the
# resolution chain has run. severity_for(), color_for() and the --json
# `palette.stops` all read these arrays, and the Omarchy panel consumes the
# published stops, so moving a threshold moves every surface at once.
GAUGE_PCTS=(0 50 75 90)
GAUGE_STATES=(low mid high critical)
GAUGE_COLORS=("$BAR_COLOR_LOW" "$BAR_COLOR_MID" "$BAR_COLOR_HIGH" "$BAR_COLOR_CRITICAL")

BAR_LEN=20

# Window durations in seconds
SESSION_WINDOW=$(( 5 * 3600 ))      # 5 hours
WEEKLY_WINDOW=$(( 7 * 24 * 3600 ))  # 7 days

# --- Helpers ---

die() {
    if [[ "$JSON_MODE" == "true" ]]; then
        # Structured mode: raw data, no Pango. Strip the <b> tags die messages
        # carry and flatten newlines; still always exit 0 with valid JSON.
        # Callers write their line breaks as the two characters \ and n (the
        # messages are double-quoted literals), so those collapse here too —
        # otherwise a backslash-n would travel into the JSON as text.
        local _m="$1"
        _m="${_m//<b>/}"; _m="${_m//<\/b>/}"
        _m="${_m//\\n/ }"; _m="${_m//$'\n'/ }"
        if command -v jq &>/dev/null; then
            jq -nc --arg m "$_m" '{schema_version:1, error:{message:$m}}'
        else
            _m="${_m//\\/\\\\}"; _m="${_m//\"/\\\"}"
            printf '{"schema_version":1,"error":{"message":"%s"}}\n' "$_m"
        fi
        exit 0
    fi
    # Waybar tooltip: turn the callers' literal \n into a real newline so the
    # second line renders as a line break instead of showing "\n" verbatim.
    local _tip="${1//\\n/$'\n'}"
    if command -v jq &>/dev/null; then
        jq -nc --arg t "⚠" --arg tip "$_tip" '{text:$t, tooltip:$tip, class:"critical"}'
    else
        local _m="${_tip//\\/\\\\}"; _m="${_m//\"/\\\"}"; _m="${_m//$'\n'/\\n}"
        printf '{"text":"⚠","tooltip":"%s","class":"critical"}\n' "$_m"
    fi
    exit 0
}

# Soft exit for transient network failures with no usable cache. Emits a neutral
# "Loading…" widget in the low class so Waybar styles it like normal usage and
# doesn't draw attention to a state that will self-resolve on the next dispatch.
loading_network() {
    if [[ "$JSON_MODE" == "true" ]]; then
        jq -nc '{schema_version:1, loading:true, error:null}'
        exit 0
    fi
    jq -nc \
        --arg t "${BAR_ICON:+${BAR_ICON} }Loading…" \
        --arg tip $'Waiting for network — no cached usage yet.\nWill retry shortly.' \
        '{text:$t, tooltip:$tip, class:"low"}'
    exit 0
}

pango_escape() {
    sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "${1:-}"
}

# Strip color from Pango markup while keeping everything structural: only the
# painting attributes go, so <span font_weight='bold'> stays bold, glyphs, bar
# fill characters, markers and box drawing are untouched, and an attribute-less
# <span> renders exactly like plain text.
#
# Tag-aware on purpose. The bar and tooltip may carry the user's own --format
# markup, so this has to cover attributes we never emit (double-quoted values,
# background=, the underline/overline/strikethrough colors) — while leaving
# body text that merely looks like an attribute alone. Names are matched in
# lowercase because that is the only spelling Pango itself honors.
decolor() {
    awk '''
    BEGIN {
        q = sprintf("%c", 39)   # single quote, built here to dodge shell quoting
        names = "foreground|fgcolor|color|background|bgcolor|underline_color|overline_color|strikethrough_color"
        re = "[ \t]+(" names ")[ \t]*=[ \t]*(\"[^\"]*\"|" q "[^" q "]*" q "|[^ \t>]+)"
    }
    {
        out = ""; rest = $0
        while ((i = index(rest, "<")) > 0) {
            out = out substr(rest, 1, i - 1)
            after = substr(rest, i + 1)
            j = index(after, ">")
            if (j == 0) { out = out substr(rest, i); rest = ""; break }
            tag = substr(after, 1, j - 1)
            rest = substr(after, j + 1)
            gsub(re, "", tag)
            out = out "<" tag ">"
        }
        print out rest
    }'''
}

# Relative age for stale messaging. Negative (clock skew) → empty, caller omits it.
rel_age() {
    local s=$1
    if   (( s < 0 ));     then return 0
    elif (( s < 60 ));    then printf 'just now'
    elif (( s < 3600 ));  then printf '%d min ago' $(( s / 60 ))
    elif (( s < 86400 )); then printf '%d h ago' $(( s / 3600 ))
    else printf '%d d ago' $(( s / 86400 ))
    fi
}

# Usage severity for a window percent, read off the gauge definition above:
# the highest band whose threshold the value has reached. Single source of
# truth for the discrete states — the Waybar class and the --json per-window
# "state" field both derive from this, and color_for interpolates between the
# very same thresholds.
severity_for() {
    local p=$1 i
    for (( i = ${#GAUGE_PCTS[@]} - 1; i > 0; i-- )); do
        (( p >= GAUGE_PCTS[i] )) && { printf '%s' "${GAUGE_STATES[i]}"; return; }
    done
    printf '%s' "${GAUGE_STATES[0]}"
}

# Continuous usage color: linear interpolation between the gauge anchors, so a
# percentage lands on exactly the color the published `palette.stops` describe.
# Anchors come from the resolution chain (--color-* > theme > pywal > built-in),
# which is why user overrides reshape the whole ramp and not just its ends.
color_for() {
    local p=$1 i last span
    (( p < 0 )) && p=0
    last=$(( ${#GAUGE_PCTS[@]} - 1 ))

    # A non-hex anchor (a Pango color name) cannot be interpolated; fall back to
    # discrete steps, which is exactly how this behaved before the gradient.
    if [[ "$GRADIENT_OK" != "true" ]]; then
        for (( i = last; i > 0; i-- )); do
            (( p >= GAUGE_PCTS[i] )) && { printf '%s' "${GAUGE_COLORS[i]}"; return; }
        done
        printf '%s' "${GAUGE_COLORS[0]}"
        return
    fi

    (( p >= GAUGE_PCTS[last] )) && { printf '%s' "${GAUGE_COLORS[last]}"; return; }
    for (( i = last - 1; i >= 0; i-- )); do
        if (( p >= GAUGE_PCTS[i] )); then
            span=$(( GAUGE_PCTS[i + 1] - GAUGE_PCTS[i] ))
            (( span <= 0 )) && { printf '%s' "${GAUGE_COLORS[i]}"; return; }
            hex_lerp "${GAUGE_COLORS[i]}" "${GAUGE_COLORS[i + 1]}" \
                $(( (p - GAUGE_PCTS[i]) * 1000 / span ))
            return
        fi
    done
    printf '%s' "${GAUGE_COLORS[0]}"
}

# Pacing severity based on signed pacing delta, centered around zero:
#   <= -11  under   (well under pace, plenty of room)     → green
#   -10..0  on_pace (slightly under or exactly on pace)   → yellow
#   1..+9   ahead   (slightly ahead, watch it)            → orange
#   >= +10  hot     (burning fast)                        → red
# Same single-source rule as severity_for: --format-pace-color and the
# --json per-window pace "state" field both derive from this.
pace_severity_for() {
    local delta=${1:-0}
    if   (( delta >= 10 ));  then printf 'hot'
    elif (( delta > 0 ));    then printf 'ahead'
    elif (( delta >= -10 )); then printf 'on_pace'
    else printf 'under'
    fi
}

pace_color_for() {
    case "$(pace_severity_for "${1:-0}")" in
        hot)     printf '%s' "$RED" ;;
        ahead)   printf '%s' "$ORANGE" ;;
        on_pace) printf '%s' "$YELLOW" ;;
        *)       printf '%s' "$GREEN" ;;
    esac
}

# Per-cell gradient colors for bar fills, precomputed once per run: the ramp
# is a fixed function of cell position. Cell k covers the bucket
# [k*5, (k+1)*5) and takes the color of its CENTRE, which is the honest
# sample for a 20-cell quantisation — reading a cell's color off an endpoint
# would claim a precision the cell does not have.
GRAD_CELLS=()
init_grad_cells() {
    local k
    for (( k = 0; k < BAR_LEN; k++ )); do
        GRAD_CELLS[k]=$(color_for $(( (k * 100 + 50) / BAR_LEN )))
    done
}

# One run of filled cells with per-cell gradient colors (positional).
grad_fill() {  # <start_cell> <count>
    local k end=$(( $1 + $2 ))
    for (( k = $1; k < end; k++ )); do
        printf "<span foreground='%s'>█</span>" "${GRAD_CELLS[k]}"
    done
}

# make_bar helpers. Both read make_bar's locals via bash dynamic scoping.
_mb_fill() {  # <start_cell> <count> — flat span, or per-cell gradient when $color is empty
    if [[ -n "$color" ]]; then
        local run; printf -v run '%*s' "$2" ''
        printf "<span foreground='%s'>%s</span>" "$color" "${run// /█}"
    else
        grad_fill "$1" "$2"
    fi
}
_mb_empty() {  # <count>
    local run; printf -v run '%*s' "$1" ''
    printf "<span foreground='%s'>%s</span>" "$BAR_EMPTY" "${run// /░}"
}

# Build a progress bar with optional elapsed marker.
# Usage: make_bar <pct> <color> [marker_pct] [marker_color]
# An empty <color> renders the filled cells with the per-cell gradient
# (init_grad_cells) instead of a flat color — used by usage-framed bars,
# where the fill sweeps the severity ramp left to right. Remaining-framed
# bars keep a flat fill: their length means "what's left", not "how hot".
# When marker is provided, a ┃ (gate) in marker_color is placed at the elapsed
# position, showing where you'd be if pacing evenly across the window.
make_bar() {
    local p=$1 color=$2 marker_pos=${3:--1} marker_color=${4:-}
    local filled=$(( p * BAR_LEN / 100 ))
    (( filled > BAR_LEN )) && filled=$BAR_LEN
    (( filled < 0 )) && filled=0

    if (( marker_pos < 0 )); then
        _mb_fill 0 "$filled"
        _mb_empty $(( BAR_LEN - filled ))
        return
    fi

    local m=$(( marker_pos * BAR_LEN / 100 ))
    (( m > BAR_LEN - 1 )) && m=$(( BAR_LEN - 1 ))
    local pre_f=$(( filled < m ? filled : m ))
    local post_f=$(( filled > m + 1 ? filled - m - 1 : 0 ))

    _mb_fill 0 "$pre_f"
    _mb_empty $(( m - pre_f ))
    printf "<span foreground='%s'>┃</span>" "$marker_color"
    _mb_fill $(( m + 1 )) "$post_f"
    _mb_empty $(( BAR_LEN - m - 1 - post_f ))
}

countdown() {
    local ts=$1
    [[ -z "$ts" ]] && { echo "—"; return; }
    local reset now diff d h m
    reset=$(date -d "$ts" +%s 2>/dev/null) || { echo "—"; return; }
    now=$(date +%s)
    diff=$(( reset - now ))
    (( diff <= 0 )) && { echo "now"; return; }
    d=$(( diff / 86400 ))
    h=$(( diff % 86400 / 3600 ))
    m=$(( diff % 3600 / 60 ))
    if (( d > 0 )); then
        echo "${d}d ${h}h"
    else
        printf '%dh %02dm' "$h" "$m"
    fi
}

# Calculate time elapsed % and pacing for a usage window.
# Uses point-based delta (actual - expected) for the icon and delta values.
# If you've used 22% and 78% of time elapsed, delta = -56 — intuitive,
# bounded, and stable across the window. Also computes the original
# ratio-based label for backward-compatible {*_pace_pct} placeholders.
#
# Args: usage_pct resets_at window_duration_seconds
# Output fields (space-separated, single-token fields first):
#   elapsed_pct pace_icon pace_indicator pace_delta pace_pct_label pace_pts_label
calc_pacing() {
    local usage_pct=$1 resets_at=$2 window_s=$3
    local elapsed_pct=0 pace_icon="→" pace_indicator="→" pace_delta="0"
    local pace_pct_label="on pace" pace_pts_label="on pace"

    if [[ -n "$resets_at" && "$resets_at" != "0" && "$resets_at" != "null" ]] && (( window_s > 0 )); then
        local reset_epoch remaining
        reset_epoch=$(date -d "$resets_at" +%s 2>/dev/null) || { echo "0 → → 0 on pace on pace"; return; }
        remaining=$(( reset_epoch - $(date +%s) ))
        elapsed_pct=$(( (window_s - remaining) * 100 / window_s ))
        (( elapsed_pct < 0 )) && elapsed_pct=0
        (( elapsed_pct > 100 )) && elapsed_pct=100

        # Point-based delta for indicator, delta, and pts label
        local delta=$(( usage_pct - elapsed_pct ))
        pace_delta="$delta"
        if (( delta > 0 )); then
            pace_indicator="↑"
            pace_pts_label="${delta}pts ahead"
        elif (( delta < 0 )); then
            pace_indicator="↓"
            pace_pts_label="$(( -delta ))pts under"
        fi

        # Ratio-based icon and label for backward-compatible {*_pace} and {*_pace_pct}
        if (( elapsed_pct > 0 )); then
            local pacing_x100=$(( usage_pct * 100 / elapsed_pct ))
            if (( pacing_x100 > 100 + PACE_TOLERANCE )); then
                local dev=$(( pacing_x100 - 100 ))
                (( dev > 999 )) && dev=999
                pace_icon="↑"
                pace_pct_label="${dev}% ahead"
            elif (( pacing_x100 < 100 - PACE_TOLERANCE )); then
                local dev=$(( 100 - pacing_x100 ))
                (( dev > 999 )) && dev=999
                pace_icon="↓"
                pace_pct_label="${dev}% under"
            fi
        fi
    fi

    echo "${elapsed_pct} ${pace_icon} ${pace_indicator} ${pace_delta} ${pace_pct_label} ${pace_pts_label}"
}

# --- Pre-checks ---
for cmd in curl jq date; do
    command -v "$cmd" &>/dev/null || die "Missing dependency: $cmd"
done
[[ -f "$CREDS" ]] || die "No credentials.\nRun <b>claude</b> to log in."

# --- Read credentials (initial — static fields only; mutable fields re-read under lock) ---
creds=$(<"$CREDS")
jq -e . <<< "$creds" &>/dev/null || die "Invalid credentials file.\nRun <b>claude</b> to log in."
sub_type=$(jq -r 'try (.claudeAiOauth.subscriptionType // "unknown") catch "unknown"' <<< "$creds")
rate_tier=$(jq -r 'try (.claudeAiOauth.rateLimitTier // "") catch ""' <<< "$creds")

# --- Cache / lock setup ---
mkdir -p "$CACHE_DIR" 2>/dev/null || die "Cannot create cache dir.\n$CACHE_DIR is not writable."
cache_file="$CACHE_DIR/usage.json"
credits_file="$CACHE_DIR/credits.json"
stale_marker="$CACHE_DIR/.stale"
net_wait_marker="$CACHE_DIR/.net_wait"
_lockfile="$CACHE_DIR/.fetch.lock"

_fetch_usage() {
    if [[ "$FORCE_REFRESH" != "true" ]] && [[ -f "$cache_file" ]] && (( cache_age < CACHE_TTL )); then
        usage=$(<"$cache_file")
        return
    fi

    if [[ "$auth_ok" == "false" ]]; then
        if [[ "$refresh_failure_kind" == "transient" ]]; then
            # Network blip — stay quiet. Reuse recent cache with an in-memory
            # stale flag, or show neutral "Loading…" if no usable cache exists.
            # No disk markers, no desktop notification.
            if [[ -f "$cache_file" ]] && (( cache_age <= WEEKLY_WINDOW )); then
                usage=$(<"$cache_file")
                transient_stale=true
                return
            fi
            loading_network
        fi
        # Hard refresh failure (4xx/5xx, malformed) — preserve actionable signal.
        if [[ -f "$cache_file" ]] && (( cache_age <= WEEKLY_WINDOW )); then
            usage=$(<"$cache_file")
            if [[ ! -f "$stale_marker" ]]; then
                touch "$stale_marker"
                command -v notify-send &>/dev/null && \
                    notify-send -u normal -i dialog-warning \
                        "Claude Usage" "Token refresh failed. Check connection or run <b>claude</b>." 2>/dev/null || true
            fi
        else
            die "Token refresh failed.\nCheck connection or run <b>claude</b>."
        fi
        return
    fi

    # Auth OK — fetch from API. Transient failures (no HTTP response: DHCP/DNS
    # still settling at boot, brief blip) are retried until the shared deadline —
    # one missed dispatch otherwise means stale data for a full Waybar interval.
    while :; do
        _resp_body=$(curl -s --max-time 10 -w '\n%{http_code}' "$API_URL" \
            -H "Authorization: Bearer $access_token" \
            -H "anthropic-beta: oauth-2025-04-20") || true
        _http_code="${_resp_body##*$'\n'}"
        _resp_body="${_resp_body%$'\n'"$_http_code"}"
        # Normalize bogus codes (e.g. raw body without curl write-out suffix) to 000.
        [[ "$_http_code" =~ ^[0-9]{3}$ ]] || _http_code="000"
        if [[ "$_http_code" != "000" ]]; then break; fi
        if (( SECONDS >= net_deadline )); then break; fi
        sleep "$NET_RETRY_DELAY"
    done

    if [[ "$_http_code" == "200" ]] && [[ -n "$_resp_body" ]] && jq -e '.five_hour' <<< "$_resp_body" &>/dev/null; then
        usage="$_resp_body"
        _ctmp=$(mktemp "$CACHE_DIR/.usage.XXXXXX")
        printf '%s' "$usage" > "$_ctmp" && mv "$_ctmp" "$cache_file"
        rm -f "$stale_marker" "$net_wait_marker" "$CACHE_DIR/.last_error"
    elif [[ "$_http_code" == "000" ]]; then
        # No HTTP response after the retry budget — network still settling or
        # offline. Mark the episode so sibling instances skip their own long
        # wait, then reuse recent cache with an in-memory stale flag (no .stale
        # on disk), or show neutral "Loading…".
        if [[ "$net_long" == "true" ]]; then touch "$net_wait_marker" 2>/dev/null || true; fi
        if [[ -f "$cache_file" ]] && (( cache_age <= WEEKLY_WINDOW )); then
            usage=$(<"$cache_file")
            transient_stale=true
        else
            loading_network
        fi
    elif [[ -f "$cache_file" ]]; then
        usage=$(<"$cache_file")
        touch "$stale_marker"
        if [[ "$_http_code" =~ ^[45][0-9]{2}$ ]]; then
            _err_msg=$(jq -r '.error.message // empty' <<< "$_resp_body" 2>/dev/null) || true
            printf '%s\n%s' "$_http_code" "$_err_msg" > "$CACHE_DIR/.last_error"
        fi
    else
        die "API request failed.\nCheck your connection."
    fi
}

_fetch_balance() {
    # No usage-credit ledger means there is nothing to query. Keep this
    # best-effort: usage windows must remain available even if the separate
    # prepaid endpoint is unavailable or changes upstream.
    local _has_credits
    _has_credits=$(jq 'try (.extra_usage != null) catch false' <<< "$usage" 2>/dev/null) || _has_credits=false
    [[ "$_has_credits" == "true" && "$auth_ok" == "true" ]] || return 0

    local _org_uuid="${CLAUDE_CODE_ORGANIZATION_UUID:-}"
    if [[ -z "$_org_uuid" && -f "$HOME/.claude.json" ]]; then
        _org_uuid=$(jq -r 'try ((.oauthAccount.organizationUuid | strings) // "") catch ""' \
            "$HOME/.claude.json" 2>/dev/null) || _org_uuid=""
    fi
    # The identifier is inserted into a URL path, so reject anything beyond
    # Claude's UUID-like alphabet instead of letting account data shape curl.
    [[ "$_org_uuid" =~ ^[A-Za-z0-9-]+$ ]] || return 0

    local _credits_age=-1
    if [[ -f "$credits_file" ]]; then
        _credits_age=$(( now_s - $(date -r "$credits_file" +%s) ))
    fi
    if [[ "$FORCE_REFRESH" != "true" ]] && (( _credits_age >= 0 && _credits_age < CACHE_TTL )); then
        return
    fi

    local _credits_url="${API_BASE_URL}/api/oauth/organizations/${_org_uuid}/prepaid/credits"
    local _credits_raw _credits_code _credits_body
    # Feed the bearer header through stdin so the token never appears in the
    # curl argv/process list.
    _credits_raw=$(printf 'header = "Authorization: Bearer %s"\nheader = "anthropic-beta: oauth-2025-04-20"\n' \
        "$access_token" | curl --config - -s --max-time 10 -w '\n%{http_code}' "$_credits_url") || true
    _credits_code="${_credits_raw##*$'\n'}"
    _credits_body="${_credits_raw%$'\n'"$_credits_code"}"
    [[ "$_credits_code" =~ ^[0-9]{3}$ ]] || _credits_code="000"

    if [[ "$_credits_code" == "200" ]] && jq -e -s '
        length == 1 and (.[0] | type) == "object"
        and ((.[0].amount | type) == "number")
        and (.[0].amount >= 0) and (.[0].amount <= 1e12)
      ' <<< "$_credits_body" &>/dev/null; then
        local _btmp
        _btmp=$(mktemp "$CACHE_DIR/.credits.XXXXXX" 2>/dev/null) || _btmp=""
        if [[ -n "$_btmp" ]]; then
            if printf '%s' "$_credits_body" > "$_btmp" && mv "$_btmp" "$credits_file"; then
                :
            else
                rm -f "$_btmp" 2>/dev/null || true
            fi
        fi
    fi
}

# --- Acquire lock for the state-changing window (refresh + usage fetch) ---
# Multi-monitor: peer instances may rotate the refresh_token between our initial
# read and our refresh attempt; locking and re-reading prevents a stale-token
# refresh from writing a misleading .last_error while credentials are actually fine.
# Braces, not a bare `exec ... 2>/dev/null`: a redirection on `exec` with no
# command persists for the REST OF THE SCRIPT, so the bare form silenced every
# later diagnostic (it hid a missing-function bug during development). The
# group scopes the silencing to this one attempt while fd 9 still survives it.
{ exec 9>"$_lockfile"; } 2>/dev/null || die "Cannot open cache lock.\nCheck ~/.cache permissions."
# Generous wait: a boot-like sibling may hold the lock for the long budget plus
# in-flight curls (worst ≈ NET_LONG_BUDGET + 25s refresh + 10s fetch ≈ 57s);
# rendering late beats dying with a visible "Cache lock timeout".
flock -w 90 9 || die "Cache lock timeout"

# --- Transient retry budget (shared by token refresh and usage fetch) ---
now_s=$(date +%s)
cache_age=-1
[[ -f "$cache_file" ]] && cache_age=$(( now_s - $(date -r "$cache_file" +%s) ))
# Missing cache or future mtime (clock skew) → boot-like, never "fresh".
if (( cache_age < 0 )); then cache_age=$(( NET_BOOT_CACHE_AGE + 1 )); fi
net_budget=$NET_QUICK_BUDGET
net_long=false
if (( cache_age > NET_BOOT_CACHE_AGE )); then
    net_budget=$NET_LONG_BUDGET
    net_long=true
    if [[ -f "$net_wait_marker" ]]; then
        _nw_age=$(( now_s - $(date -r "$net_wait_marker" +%s) ))
        # A sibling already burned the long budget this episode — single
        # attempt, no sleeps. Future mtimes (clock skew) don't count.
        if (( _nw_age >= 0 && _nw_age <= NET_WAIT_RECENT )); then
            net_budget=0
            net_long=false
        fi
    fi
fi
net_deadline=$(( SECONDS + net_budget ))

# Re-read mutable credential fields under the lock.
[[ -f "$CREDS" ]] || die "No credentials.\nRun <b>claude</b> to log in."
creds=$(<"$CREDS")
jq -e . <<< "$creds" &>/dev/null || die "Invalid credentials file.\nRun <b>claude</b> to log in."
access_token=$(jq -r 'try (.claudeAiOauth.accessToken // empty) catch empty' <<< "$creds")
refresh_token=$(jq -r 'try (.claudeAiOauth.refreshToken // empty) catch empty' <<< "$creds")
expires_at=$(jq -r 'try (.claudeAiOauth.expiresAt // 0) catch 0' <<< "$creds")
expires_at="${expires_at%%.*}" # truncate float (e.g. 5000.0 → 5000)
[[ "$expires_at" =~ ^[0-9]+$ ]] || expires_at=0
expires_s=$(( expires_at / 1000 ))
auth_ok=true
refresh_failure_kind=""
transient_stale=false

[[ -n "$access_token" ]] || die "No token.\nRun <b>claude</b> to log in."

if (( expires_s < now_s + REFRESH_BUFFER )); then
    # Synchronous refresh — 25s timeout covers cold boot when DHCP is still settling.
    # Transient failures (no HTTP response) are retried until the shared deadline —
    # same policy as the usage fetch — so a cold-boot race doesn't cost a full interval.
    refresh_body=$(jq -nc --arg ci "$CLIENT_ID" --arg rt "$refresh_token" \
                     '{grant_type:"refresh_token", client_id:$ci, refresh_token:$rt}')
    while :; do
        refresh_raw=$(curl -s --max-time 25 -w '\n%{http_code}' -X POST "$TOKEN_URL" \
            -H "Content-Type: application/json" \
            -H "anthropic-beta: oauth-2025-04-20" \
            -H "User-Agent: claude-cli/1.0" \
            --data "$refresh_body") || true
        refresh_code="${refresh_raw##*$'\n'}"
        resp="${refresh_raw%$'\n'"$refresh_code"}"
        # Normalize bogus codes (e.g. raw body without curl write-out suffix) to 000.
        [[ "$refresh_code" =~ ^[0-9]{3}$ ]] || refresh_code="000"
        if [[ "$refresh_code" != "000" ]]; then break; fi
        if (( SECONDS >= net_deadline )); then break; fi
        sleep "$NET_RETRY_DELAY"
    done

    if [[ "$refresh_code" == "200" ]] && [[ -n "$resp" ]] && jq -e '.access_token' <<< "$resp" &>/dev/null; then
        access_token=$(jq -r '.access_token' <<< "$resp")
        new_refresh=$(jq -r '.refresh_token // empty' <<< "$resp")
        expires_in=$(jq -r 'try (((.expires_in | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$resp")
        expires_in="${expires_in%%.*}" # truncate float (e.g. 3600.0 → 3600)
        [[ "$expires_in" =~ ^[0-9]+$ ]] || expires_in=3600
        new_expires_at=$(( $(date +%s) * 1000 + expires_in * 1000 ))

        tmp=$(mktemp)
        jq --arg at "$access_token" \
           --arg rt "${new_refresh:-$refresh_token}" \
           --argjson ea "$new_expires_at" \
           '.claudeAiOauth.accessToken=$at | .claudeAiOauth.refreshToken=$rt | .claudeAiOauth.expiresAt=$ea' \
           "$CREDS" > "$tmp" && mv "$tmp" "$CREDS"
        rm -f "$CACHE_DIR/.last_error"
    else
        auth_ok=false
        if [[ "$refresh_code" == "000" ]]; then
            # No HTTP response reached us — DHCP/DNS settling at boot, offline,
            # or actual timeout. Mark the episode so sibling instances skip
            # their own long wait; nothing else persists.
            refresh_failure_kind="transient"
            if [[ "$net_long" == "true" ]]; then touch "$net_wait_marker" 2>/dev/null || true; fi
        else
            refresh_failure_kind="hard"
            # Always write a current .last_error so the tooltip reflects this refresh
            # failure, never a leftover entry from a previous /usage call.
            refresh_err=""
            if [[ "$refresh_code" =~ ^[45][0-9]{2}$ ]]; then
                # platform.claude.com returns OAuth-style {error,error_description};
                # fall back to Anthropic-style {error:{message}} or bare {error:"<str>"}.
                refresh_err=$(jq -r '
                    if (.error_description | type) == "string" then .error_description
                    elif (.error | type) == "object" and (.error | has("message")) and (.error.message | type) == "string" then .error.message
                    elif (.error | type) == "string" then .error
                    else "" end' <<< "$resp" 2>/dev/null) || true
                [[ -z "$refresh_err" ]] && refresh_err="Refresh failed"
            else
                refresh_err="Invalid refresh response"
            fi
            # Best-effort write — never abort the widget if the cache dir is unwriteable.
            _le_tmp=$(mktemp "$CACHE_DIR/.last_error.XXXXXX" 2>/dev/null) || _le_tmp=""
            if [[ -n "$_le_tmp" ]]; then
                if printf '%s\n%s' "$refresh_code" "$refresh_err" > "$_le_tmp" 2>/dev/null \
                   && mv "$_le_tmp" "$CACHE_DIR/.last_error" 2>/dev/null; then
                    :
                else
                    rm -f "$_le_tmp" 2>/dev/null || true
                fi
            fi
        fi
    fi
fi

_fetch_usage
_fetch_balance
exec 9>&-

# A corrupt or partially-written cache could leave $usage as invalid JSON; the
# per-field try/catch reads can't catch a jq *parse* error, so guard the whole
# payload here (degrades to a clear warning, still exit 0).
jq -e -s 'length == 1' <<< "$usage" &>/dev/null || die "Invalid usage data.\nWill refresh next cycle."

# --- Parse windows ---
# round in jq -> integer literal. A bare float ("13.0") fed to printf '%.0f'
# is rejected as "invalid number" under comma-decimal locales (es_AR, de_DE, ...),
# where strtod won't accept the period.
parse_pct() {
    jq -r "try (((.$1.utilization | numbers) // 0) | round | if (. > 1e12 or . < 0) then 0 else . end) catch 0" <<< "$usage"
}

parse_reset() {
    jq -r "try (.$1.resets_at // empty) catch empty" <<< "$usage"
}

# Remaining percent for a window: 100 - used, clamped 0..100. Clamps ONLY its own
# output — never mutates the source used pct (that would change no-flag output).
remaining_pct_for() {
    local r=$(( 100 - $1 ))
    (( r < 0 )) && r=0
    (( r > 100 )) && r=100
    echo "$r"
}

# Framing helpers: usage by default, "remaining" when --remaining. Centralized so the
# no-flag path is byte-identical and the rendered bar/number never diverge.
display_pct() {  # <used_pct>
    if [[ "$REMAINING" == "true" ]]; then remaining_pct_for "$1"; else echo "$1"; fi
}
display_bar() {  # <used_pct> <elapsed> [marker_on]  (marker_on: pass "$TOOLTIP_PACE_PTS")
    local used=$1 elapsed=$2 marker_on=${3:-}
    local color; color=$(color_for "$used")
    if [[ "$REMAINING" == "true" ]]; then
        local rem; rem=$(remaining_pct_for "$used")
        if [[ "$marker_on" == "true" ]]; then make_bar "$rem" "$color" "$(( 100 - elapsed ))" "$MARKER"
        else make_bar "$rem" "$color"; fi
    else
        # Usage framing: per-cell gradient fill (empty color arg).
        if [[ "$marker_on" == "true" ]]; then make_bar "$used" "" "$elapsed" "$MARKER"
        else make_bar "$used" ""; fi
    fi
}

session_pct=$(parse_pct five_hour)
session_reset=$(parse_reset five_hour)
weekly_pct=$(parse_pct seven_day)
weekly_reset=$(parse_reset seven_day)

has_sonnet=$(jq 'try (.seven_day_sonnet != null) catch false' <<< "$usage")
sonnet_pct=0
sonnet_reset=""
if [[ "$has_sonnet" == "true" ]]; then
    sonnet_pct=$(parse_pct seven_day_sonnet)
    sonnet_reset=$(parse_reset seven_day_sonnet)
fi

# --- Model-scoped weekly limits (e.g. Fable) ---
# Newer payloads report per-model weekly limits through the limits[] array
# (kind "weekly_scoped" with a scope.model) instead of a dedicated
# seven_day_<model> field. Every well-formed entry (capped at 4 — hostile
# payloads must not grow the tooltip or burn CPU each interval) gets its own
# tooltip section and counts toward the Waybar class; {model_*} placeholders
# track the FIRST entry. When seven_day_sonnet is already rendered, a scoped
# Sonnet entry is a duplicate window, so skip it (later entries still win).
# One jq pass emits name<TAB>pct<TAB>reset per entry: limit() stops early on
# huge arrays; the name is control-stripped (kills tabs) then Pango-escaped
# in jq, so plain join("\t") is delimiter-safe and byte-faithful.
_model_rows=()
readarray -t _model_rows < <(jq -r --argjson skip_sonnet "$has_sonnet" '
    def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
    def clean: gsub("[[:cntrl:]]"; " ") | if gsub(" "; "") == "" then "Model" else . end;
    try (limit(4; ((.limits? | arrays) // [])[]
        | select(type == "object" and .kind == "weekly_scoped"
            and ((.scope? | type) == "object")
            and ((.scope.model | type) == "object")
            and (($skip_sonnet and (.scope.model.display_name == "Sonnet")) | not))
        | [ ((.scope.model.display_name | strings) // "Model" | clean | esc),
            (((.percent | numbers) // 0) | round | if (. > 1e12 or . < 0) then 0 else . end | tostring),
            ((.resets_at | strings) // "" | gsub("[[:cntrl:]]"; "")) ]
        | join("\t"))) catch empty' <<< "$usage")

has_model=false
model_names_esc=() model_pcts=() model_resets=()
model_max_pct=0
for _row in "${_model_rows[@]}"; do
    IFS=$'\t' read -r _mn _mp _mr <<< "$_row"
    model_names_esc+=("$_mn")
    model_pcts+=("${_mp:-0}")
    model_resets+=("${_mr:-}")
    (( ${_mp:-0} > model_max_pct )) && model_max_pct=${_mp:-0}
done
model_name_esc=""
model_pct=0
model_reset=""
if (( ${#model_pcts[@]} > 0 )); then
    model_name_esc="${model_names_esc[0]}"
    model_pct="${model_pcts[0]}"
    model_reset="${model_resets[0]}"
    has_model=true
fi

session_remaining_pct=$(remaining_pct_for "$session_pct")
weekly_remaining_pct=$(remaining_pct_for "$weekly_pct")
sonnet_remaining_pct=$(remaining_pct_for "$sonnet_pct")
model_remaining_pct=$(remaining_pct_for "$model_pct")

# --- Extra usage ---
# Show whenever there is real spend data, not only when actively enabled: the API
# reports is_enabled=false (disabled_reason "out_of_credits") once the balance is
# depleted, but month-to-date spend and the cap remain present. Gating on
# is_enabled hid the useful spending history in that state.
has_extra=$(jq 'try (.extra_usage != null) catch false' <<< "$usage")
extra_show="false"
extra_spent=""
extra_available=""
extra_funded=""
extra_limit=""
extra_pct=0
extra_pct_value=0
extra_balance_known=false
local_available=0
local_funded=0
if [[ "$has_extra" == "true" ]]; then
    local_limit=$(jq -r 'try (((.extra_usage.monthly_limit | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
    local_used=$(jq -r 'try (((.extra_usage.used_credits | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
    disabled_reason=$(jq -r 'try ((.extra_usage.disabled_reason | strings) // "") catch ""' <<< "$usage")

    # The prepaid balance is independent from the monthly spending limit. Use
    # the separately cached ledger response when it is a safe non-negative
    # integer; if Claude explicitly says the ledger is exhausted, zero is exact.
    # Any other missing/malformed balance stays unknown — never substitute the
    # monthly limit, which is only a safety cap.
    _credits_fresh=false
    if [[ -f "$credits_file" ]]; then
        _credits_age=$(( $(date +%s) - $(date -r "$credits_file" +%s) ))
        (( _credits_age >= 0 && _credits_age < CACHE_TTL )) && _credits_fresh=true
    fi
    if [[ "$_credits_fresh" == "true" ]] && jq -e -s '
        length == 1 and (.[0] | type) == "object"
        and ((.[0].amount | type) == "number")
        and (.[0].amount >= 0) and (.[0].amount <= 1e12)
      ' "$credits_file" &>/dev/null; then
        local_available=$(jq -r '.amount | floor' "$credits_file")
        extra_balance_known=true
    elif [[ "$disabled_reason" == "out_of_credits" ]]; then
        local_available=0
        extra_balance_known=true
    fi
    # Only populate display values (and show the section) when there is real
    # spend data — leaving the dollar placeholders empty for a zero/never-set
    # extra_usage object, exactly as when this was gated on is_enabled.
    if (( local_limit > 0 || local_used > 0 )); then
        extra_show="true"
        # Convert cents to dollars (integer math: 5000 → "50.00")
        # Use absolute values for formatting to avoid "$-1.-50" with negative remainders
        _fmt_dollars() {
            local cents=$1 sign="" abs
            (( cents < 0 )) && sign="-" && cents=$(( -cents ))
            abs=$cents
            printf '%s$%d.%02d' "$sign" $(( abs / 100 )) $(( abs % 100 ))
        }
        extra_limit=$(_fmt_dollars "$local_limit")
        extra_spent=$(_fmt_dollars "$local_used")
        if [[ "$extra_balance_known" == "true" ]]; then
            local_funded=$(( local_used + local_available ))
            extra_available=$(_fmt_dollars "$local_available")
            extra_funded=$(_fmt_dollars "$local_funded")
            if (( local_funded > 0 )); then
                # Round to the nearest whole percent; QML and Waybar consume
                # the same normalized value. Clamp hostile/inconsistent data.
                extra_pct_value=$(( (local_used * 100 + local_funded / 2) / local_funded ))
                (( extra_pct_value > 100 )) && extra_pct_value=100
            fi
            extra_pct=$extra_pct_value
        else
            extra_pct=""
        fi
    fi
fi

# --- Plan label ---
plan="${sub_type^}"
if   [[ "$rate_tier" == *"5x"* ]];  then plan+=" 5x"
elif [[ "$rate_tier" == *"20x"* ]]; then plan+=" 20x"
fi

# --- Pacing ---
# Output: elapsed icon indicator delta pct_label pts_label
_s_pace=$(calc_pacing "$session_pct" "$session_reset" "$SESSION_WINDOW")
read -r session_elapsed session_pace session_pace_indicator session_pace_delta _discard <<< "$_s_pace"
session_pace_pct=$(cut -d' ' -f5-6 <<< "$_s_pace")
session_pace_pts=$(cut -d' ' -f7-8 <<< "$_s_pace")

_w_pace=$(calc_pacing "$weekly_pct" "$weekly_reset" "$WEEKLY_WINDOW")
read -r weekly_elapsed weekly_pace weekly_pace_indicator weekly_pace_delta _discard <<< "$_w_pace"
weekly_pace_pct=$(cut -d' ' -f5-6 <<< "$_w_pace")
weekly_pace_pts=$(cut -d' ' -f7-8 <<< "$_w_pace")

sonnet_elapsed=0 sonnet_pace="" sonnet_pace_indicator="" sonnet_pace_pct="" sonnet_pace_pts="" sonnet_pace_delta="0"
if [[ "$has_sonnet" == "true" ]]; then
    _n_pace=$(calc_pacing "$sonnet_pct" "$sonnet_reset" "$WEEKLY_WINDOW")
    read -r sonnet_elapsed sonnet_pace sonnet_pace_indicator sonnet_pace_delta _discard <<< "$_n_pace"
    sonnet_pace_pct=$(cut -d' ' -f5-6 <<< "$_n_pace")
    sonnet_pace_pts=$(cut -d' ' -f7-8 <<< "$_n_pace")
fi

model_elapsed=0 model_pace="" model_pace_indicator="" model_pace_pct="" model_pace_pts="" model_pace_delta="0"
if [[ "$has_model" == "true" ]]; then
    _m_pace=$(calc_pacing "$model_pct" "$model_reset" "$WEEKLY_WINDOW")
    read -r model_elapsed model_pace model_pace_indicator model_pace_delta _discard <<< "$_m_pace"
    model_pace_pct=$(cut -d' ' -f5-6 <<< "$_m_pace")
    model_pace_pts=$(cut -d' ' -f7-8 <<< "$_m_pace")
fi

# --- Tooltip pace icon (ratio or point-based) ---
if [[ "$TOOLTIP_PACE_PTS" == "true" ]]; then
    _tip_session_pace="$session_pace_indicator"
    _tip_weekly_pace="$weekly_pace_indicator"
    _tip_sonnet_pace="$sonnet_pace_indicator"
    _tip_model_pace="$model_pace_indicator"
else
    _tip_session_pace="$session_pace"
    _tip_weekly_pace="$weekly_pace"
    _tip_sonnet_pace="$sonnet_pace"
    _tip_model_pace="$model_pace"
fi

# --- Pace colors ---
# Sets _sp_<prefix>_{pace,indicator,pct,pts,delta,abs_delta} for apply_format.
_precompute_pace() {
    local pfx=$1 pace=$2 indicator=$3 pct=$4 pts=$5 delta=$6
    if [[ "$FORMAT_PACE_COLOR" == "true" ]]; then
        local c; c=$(pace_color_for "${delta:-0}")
        printf -v "_sp_${pfx}_pace"      "<span foreground='%s'>%s</span>" "$c" "$pace"
        printf -v "_sp_${pfx}_indicator" "<span foreground='%s'>%s</span>" "$c" "$indicator"
        printf -v "_sp_${pfx}_pct"       "<span foreground='%s'>%s</span>" "$c" "$pct"
        printf -v "_sp_${pfx}_pts"       "<span foreground='%s'>%s</span>" "$c" "$pts"
        printf -v "_sp_${pfx}_delta"     "<span foreground='%s'>%s</span>" "$c" "$delta"
        printf -v "_sp_${pfx}_abs_delta" "<span foreground='%s'>%s</span>" "$c" "${delta#-}"
    else
        printf -v "_sp_${pfx}_pace"      '%s' "$pace"
        printf -v "_sp_${pfx}_indicator" '%s' "$indicator"
        printf -v "_sp_${pfx}_pct"       '%s' "$pct"
        printf -v "_sp_${pfx}_pts"       '%s' "$pts"
        printf -v "_sp_${pfx}_delta"     '%s' "$delta"
        printf -v "_sp_${pfx}_abs_delta" '%s' "${delta#-}"
    fi
}
_precompute_pace session "$session_pace" "$session_pace_indicator" "$session_pace_pct" "$session_pace_pts" "$session_pace_delta"
_precompute_pace weekly  "$weekly_pace"  "$weekly_pace_indicator"  "$weekly_pace_pct"  "$weekly_pace_pts"  "$weekly_pace_delta"
_precompute_pace sonnet  "$sonnet_pace"  "$sonnet_pace_indicator"  "$sonnet_pace_pct"  "$sonnet_pace_pts"  "$sonnet_pace_delta"
_precompute_pace model   "$model_pace"   "$model_pace_indicator"   "$model_pace_pct"   "$model_pace_pts"   "$model_pace_delta"

# --- Waybar class (granular: low, mid, high, critical) ---
# Rate limits first; extra usage only matters when a rate limit hits 100%
max_pct=$session_pct
(( weekly_pct > max_pct )) && max_pct=$weekly_pct
(( sonnet_pct > max_pct )) && max_pct=$sonnet_pct
(( model_max_pct > max_pct )) && max_pct=$model_max_pct
if (( session_pct >= 100 || weekly_pct >= 100 || sonnet_pct >= 100 || model_max_pct >= 100 )); then
    (( extra_pct_value > max_pct )) && max_pct=$extra_pct_value
fi

class=$(severity_for "$max_pct")

# --- Bar text color: the value the bar SHOWS, not the worst one ---
# `class` above is the Waybar CSS class and must stay worst-of-all — that is what
# a user styles "critical" on. The bar TEXT is different: colouring a 34% session
# red because a hidden weekly limit is high reports a severity the number beside
# it does not have, and it disagreed with the Omarchy panel, which paints the
# ramp at the percentage it displays. So the tint follows whichever window the
# format actually puts on the bar; a format that names neither keeps the default
# (session), and a maxed-out OTHER window still reaches the user through the CSS
# class and the tooltip.
bar_pct=$session_pct
if [[ "$FORMAT" != *"{session_pct}"* ]]; then
    if   [[ "$FORMAT" == *"{weekly_pct}"* ]]; then bar_pct=$weekly_pct
    elif [[ "$FORMAT" == *"{sonnet_pct}"* ]]; then bar_pct=$sonnet_pct
    fi
fi
bar_fg=$(color_for "$bar_pct")

# --- Structured JSON output (--json) ---
# Raw data for alternative frontends (e.g. the Omarchy shell plugin in
# omarchy/): numbers stay numbers, timestamps stay ISO-8601, severity is a
# state string from severity_for/pace_severity_for. Presentation — colors,
# bars, countdown text — is entirely the frontend's job, so no Pango here.
if [[ "$JSON_MODE" == "true" ]]; then
    # Reverse of the Pango esc applied when model names were extracted
    # (& was escaped first there, so it is unescaped last here). The quoted
    # "&" keeps the replacement literal under bash 5.2's patsub_replacement,
    # where an unquoted & would expand to the match itself.
    unescape_pango() {
        local s="$1"
        s="${s//&lt;/<}"; s="${s//&gt;/>}"; s="${s//&amp;/"&"}"
        printf '%s' "$s"
    }

    # One usage window as a JSON object.
    # Args: used_pct resets_at elapsed_pct pace_icon pace_indicator pace_delta
    #       pace_pct_label pace_pts_label
    json_window() {
        jq -nc \
            --argjson pct "$1" --arg reset "$2" --argjson elapsed "$3" \
            --arg icon "$4" --arg indicator "$5" --argjson delta "${6:-0}" \
            --arg pctl "$7" --arg ptsl "$8" \
            --argjson rem "$(remaining_pct_for "$1")" \
            --arg state "$(severity_for "$1")" \
            --arg pstate "$(pace_severity_for "${6:-0}")" \
            '{used_pct:$pct, remaining_pct:$rem,
              resets_at:(if $reset == "" then null else $reset end),
              elapsed_pct:$elapsed, state:$state,
              pace:{delta_pts:$delta, icon:$icon, indicator:$indicator,
                    ratio_label:$pctl, pts_label:$ptsl, state:$pstate}}'
    }

    _json_sonnet="null"
    if [[ "$has_sonnet" == "true" ]]; then
        _json_sonnet=$(json_window "$sonnet_pct" "$sonnet_reset" "$sonnet_elapsed" \
            "$sonnet_pace" "$sonnet_pace_indicator" "$sonnet_pace_delta" \
            "$sonnet_pace_pct" "$sonnet_pace_pts")
    fi

    # One entry per model-scoped weekly limit. Index 0 reuses the pacing
    # already computed for the {model_*} placeholders; later entries compute
    # inline — same split the tooltip renderer uses.
    _json_models="[]"
    for _mi in "${!model_pcts[@]}"; do
        _mp="${model_pcts[$_mi]}"
        if (( _mi == 0 )); then
            _me=$model_elapsed _mic=$model_pace _min=$model_pace_indicator
            _md=$model_pace_delta _mpl=$model_pace_pct _mtl=$model_pace_pts
        else
            _mo=$(calc_pacing "$_mp" "${model_resets[$_mi]}" "$WEEKLY_WINDOW")
            read -r _me _mic _min _md _discard <<< "$_mo"
            _mpl=$(cut -d' ' -f5-6 <<< "$_mo")
            _mtl=$(cut -d' ' -f7-8 <<< "$_mo")
        fi
        _mw=$(json_window "$_mp" "${model_resets[$_mi]}" "$_me" "$_mic" "$_min" "$_md" "$_mpl" "$_mtl")
        _json_models=$(jq -c --argjson w "$_mw" --arg n "$(unescape_pango "${model_names_esc[$_mi]}")" \
            '. + [{name:$n} + $w]' <<< "$_json_models")
    done

    _json_extra="null"
    if [[ "$extra_show" == "true" ]]; then
        _json_available=null _json_funded=null _json_extra_pct=null
        if [[ "$extra_balance_known" == "true" ]]; then
            _json_available=$local_available
            _json_funded=$local_funded
            _json_extra_pct=$extra_pct_value
        fi
        _json_extra=$(jq -nc \
            --argjson used "$local_used" --argjson limit "$local_limit" \
            --argjson available "$_json_available" --argjson funded "$_json_funded" \
            --argjson known "$extra_balance_known" --argjson pct "$_json_extra_pct" \
            --arg state "$(severity_for "$extra_pct_value")" \
            '{used_credit_cents:$used, available_credit_cents:$available,
              funded_credit_cents:$funded, monthly_limit_cents:$limit,
              balance_known:$known, used_pct:$pct, state:$state}')
    fi

    _json_updated=""
    _json_age=null
    if [[ -f "$cache_file" ]]; then
        _jcts=$(date -r "$cache_file" +%s)
        _json_updated=$(date -u -d "@${_jcts}" +%Y-%m-%dT%H:%M:%SZ)
        _json_age=$(( $(date +%s) - _jcts ))
        # Future mtime (clock skew) must not leak a negative age.
        (( _json_age < 0 )) && _json_age=0
    fi
    _json_stale=false
    _json_stale_kind=""
    if [[ "${transient_stale:-false}" == "true" ]]; then
        _json_stale=true; _json_stale_kind="network"
    elif [[ -f "$stale_marker" ]]; then
        _json_stale=true; _json_stale_kind="api"
    fi
    _json_err_code=""
    _json_err_msg=""
    if [[ -f "$CACHE_DIR/.last_error" ]]; then
        { read -r _json_err_code || true; read -r _json_err_msg || true; } < "$CACHE_DIR/.last_error" 2>/dev/null || true
        [[ "$_json_err_code" =~ ^[0-9]+$ && "$_json_err_code" != "000" ]] || _json_err_code=""
    fi

    # The ramp itself, colors and the percentages they sit at, so a frontend
    # interpolates the same gauge instead of hardcoding these thresholds again.
    _gauge_rows=""
    for _gi in "${!GAUGE_PCTS[@]}"; do
        _gauge_rows+="${GAUGE_PCTS[$_gi]} ${GAUGE_COLORS[$_gi]}"$'\n'
    done
    _json_stops=$(printf '%s' "$_gauge_rows" | jq -R -s '
        split("\n") | map(select(length > 0) | split(" ")
                          | {pct: (.[0] | tonumber), color: .[1]})')

    jq -nc \
        --arg plan "$plan" \
        --arg pal_low "$BAR_COLOR_LOW" --arg pal_mid "$BAR_COLOR_MID" \
        --arg pal_high "$BAR_COLOR_HIGH" --arg pal_critical "$BAR_COLOR_CRITICAL" \
        --argjson pal_stops "$_json_stops" \
        --argjson session "$(json_window "$session_pct" "$session_reset" "$session_elapsed" \
            "$session_pace" "$session_pace_indicator" "$session_pace_delta" \
            "$session_pace_pct" "$session_pace_pts")" \
        --argjson weekly "$(json_window "$weekly_pct" "$weekly_reset" "$weekly_elapsed" \
            "$weekly_pace" "$weekly_pace_indicator" "$weekly_pace_delta" \
            "$weekly_pace_pct" "$weekly_pace_pts")" \
        --argjson sonnet "$_json_sonnet" \
        --argjson models "$_json_models" \
        --argjson extra "$_json_extra" \
        --argjson max_pct "$max_pct" --arg overall "$class" \
        --arg updated "$_json_updated" --argjson age "$_json_age" \
        --argjson stale "$_json_stale" --arg stale_kind "$_json_stale_kind" \
        --arg err_code "$_json_err_code" --arg err_msg "$_json_err_msg" \
        '{schema_version:1, plan:$plan,
          session:$session, weekly:$weekly, sonnet:$sonnet, models:$models,
          extra_usage:$extra,
          palette:{low:$pal_low, mid:$pal_mid, high:$pal_high, critical:$pal_critical,
                   stops:$pal_stops},
          overall:{max_pct:$max_pct, state:$overall},
          cache:{updated_at:(if $updated == "" then null else $updated end),
                 age_s:$age, stale:$stale,
                 stale_kind:(if $stale_kind == "" then null else $stale_kind end)},
          error:(if $err_code == "" then null
                 else {message:(if $err_msg == "" then ("HTTP " + $err_code) else $err_msg end),
                       code:($err_code|tonumber)} end)}'
    exit 0
fi

# --- Escape API-supplied strings for Pango ---
# Everything below renders markup, and the plan label comes from the credentials
# file, so a stray & or < would produce invalid markup (Waybar then drops the
# whole label). The structured output above is deliberately escape-free: it
# carries raw data, and jq handles its own quoting. The per-model meter names
# are escaped at their own render site.
plan=$(pango_escape "$plan")

# --- Apply format placeholders ---
# When --format-pace-color is set, pace placeholders are individually colored
# per window based on pacing delta. Otherwise they inherit the bar color.
apply_format() {
    local text="$1"
    text="${text//\{icon\}/󰚩}"
    text="${text//\{plan\}/$plan}"
    text="${text//\{session_pct\}/$session_pct}"
    text="${text//\{session_reset\}/$s_cd_val}"
    text="${text//\{session_elapsed\}/$session_elapsed}"
    text="${text//\{weekly_pct\}/$weekly_pct}"
    text="${text//\{weekly_reset\}/$w_cd_val}"
    text="${text//\{weekly_elapsed\}/$weekly_elapsed}"
    text="${text//\{sonnet_pct\}/$sonnet_pct}"
    text="${text//\{session_remaining_pct\}/$session_remaining_pct}"
    text="${text//\{weekly_remaining_pct\}/$weekly_remaining_pct}"
    text="${text//\{sonnet_remaining_pct\}/$sonnet_remaining_pct}"
    text="${text//\{sonnet_reset\}/$sn_cd_val}"
    text="${text//\{sonnet_elapsed\}/$sonnet_elapsed}"
    # Quoted replacement: & in the escaped name must stay literal under
    # bash 5.2's patsub_replacement (unquoted & expands to the match).
    text="${text//\{model_name\}/"$model_name_esc"}"
    text="${text//\{model_pct\}/$model_pct}"
    text="${text//\{model_reset\}/$m_cd_val}"
    text="${text//\{model_elapsed\}/$model_elapsed}"
    text="${text//\{model_remaining_pct\}/$model_remaining_pct}"
    text="${text//\{extra_spent\}/$extra_spent}"
    text="${text//\{extra_limit\}/$extra_limit}"
    text="${text//\{extra_pct\}/$extra_pct}"
    text="${text//\{session_bar\}/$format_session_bar}"
    text="${text//\{weekly_bar\}/$format_weekly_bar}"
    text="${text//\{sonnet_bar\}/$format_sonnet_bar}"
    text="${text//\{model_bar\}/$format_model_bar}"
    text="${text//\{extra_bar\}/$format_extra_bar}"
    text="${text//\{session_remaining_bar\}/$format_session_remaining_bar}"
    text="${text//\{weekly_remaining_bar\}/$format_weekly_remaining_bar}"
    text="${text//\{sonnet_remaining_bar\}/$format_sonnet_remaining_bar}"
    text="${text//\{model_remaining_bar\}/$format_model_remaining_bar}"

    # Pace placeholders — pre-computed colored or plain depending on --format-pace-color.
    text="${text//\{session_pace_indicator\}/$_sp_session_indicator}"
    text="${text//\{session_pace_abs_delta\}/$_sp_session_abs_delta}"
    text="${text//\{session_pace_delta\}/$_sp_session_delta}"
    text="${text//\{session_pace_pct\}/$_sp_session_pct}"
    text="${text//\{session_pace_pts\}/$_sp_session_pts}"
    text="${text//\{session_pace\}/$_sp_session_pace}"
    text="${text//\{weekly_pace_indicator\}/$_sp_weekly_indicator}"
    text="${text//\{weekly_pace_abs_delta\}/$_sp_weekly_abs_delta}"
    text="${text//\{weekly_pace_delta\}/$_sp_weekly_delta}"
    text="${text//\{weekly_pace_pct\}/$_sp_weekly_pct}"
    text="${text//\{weekly_pace_pts\}/$_sp_weekly_pts}"
    text="${text//\{weekly_pace\}/$_sp_weekly_pace}"
    text="${text//\{sonnet_pace_indicator\}/$_sp_sonnet_indicator}"
    text="${text//\{sonnet_pace_abs_delta\}/$_sp_sonnet_abs_delta}"
    text="${text//\{sonnet_pace_delta\}/$_sp_sonnet_delta}"
    text="${text//\{sonnet_pace_pct\}/$_sp_sonnet_pct}"
    text="${text//\{sonnet_pace_pts\}/$_sp_sonnet_pts}"
    text="${text//\{sonnet_pace\}/$_sp_sonnet_pace}"
    text="${text//\{model_pace_indicator\}/$_sp_model_indicator}"
    text="${text//\{model_pace_abs_delta\}/$_sp_model_abs_delta}"
    text="${text//\{model_pace_delta\}/$_sp_model_delta}"
    text="${text//\{model_pace_pct\}/$_sp_model_pct}"
    text="${text//\{model_pace_pts\}/$_sp_model_pts}"
    text="${text//\{model_pace\}/$_sp_model_pace}"

    printf '%s' "$text"
}

# Compute countdowns once
s_cd_val=$(countdown "$session_reset")
w_cd_val=$(countdown "$weekly_reset")
sn_cd_val=""
[[ "$has_sonnet" == "true" ]] && sn_cd_val=$(countdown "$sonnet_reset")
m_cd_val=""
[[ "$has_model" == "true" ]] && m_cd_val=$(countdown "$model_reset")

# Per-window colors and bars used by --format / --tooltip-format placeholders.
# Each bar is colored by its own window's usage, independent of the bar text wrapper.
# Usage-framed bars carry the per-cell gradient; remaining-framed bars keep a
# flat fill colored by the (continuous) usage color.
init_grad_cells
session_color=$(color_for "$session_pct")
weekly_color=$(color_for "$weekly_pct")
sonnet_color=$(color_for "$sonnet_pct")
model_color=$(color_for "$model_pct")
extra_color=$(color_for "$extra_pct_value")
format_session_bar=$(make_bar "$session_pct" "")
format_weekly_bar=$(make_bar "$weekly_pct" "")
format_sonnet_bar=$(make_bar "$sonnet_pct" "")
format_model_bar=$(make_bar "$model_pct" "")
format_extra_bar=""
[[ "$extra_balance_known" == "true" ]] && format_extra_bar=$(make_bar "$extra_pct_value" "")
format_session_remaining_bar=$(make_bar "$session_remaining_pct" "$session_color")
format_weekly_remaining_bar=$(make_bar "$weekly_remaining_pct" "$weekly_color")
format_sonnet_remaining_bar=$(make_bar "$sonnet_remaining_pct" "$sonnet_color")
format_model_remaining_bar=$(make_bar "$model_remaining_pct" "$model_color")

# Stale data indicator
stale_icon=""
[[ -f "$stale_marker" || "${transient_stale:-false}" == "true" ]] && stale_icon=" "   # nf-fa-pause (U+23F8 renders as a color emoji)

bar_text=$(apply_format "$FORMAT")${stale_icon}

# --- Colorize bar text via Pango ---
if [[ "$BAR_PLAIN" == "true" ]]; then
    # Monochrome bar: no wrapper, and any color a placeholder brought with it
    # (progress bars, per-window pace colors) is stripped. The class field is
    # untouched, so CSS remains the way to style this.
    bar_text="${BAR_ICON:+${BAR_ICON} }${bar_text}"
    bar_text=$(printf '%s' "$bar_text" | decolor)
elif [[ "$FORMAT_PACE_COLOR" == "true" && "$FORMAT" == *_pace* ]]; then
    # Neutral base; pace placeholders provide their own color
    bar_text="<span foreground='${FG}'>${BAR_ICON:+${BAR_ICON} }${bar_text}</span>"
else
    bar_text="<span foreground='${bar_fg}'>${BAR_ICON:+${BAR_ICON} }${bar_text}</span>"
fi

# --- Stale status note ---
# One explicit line saying WHY the ⏸ is shown and how old the data is. Used as
# the footer of the default tooltip and appended to custom tooltips (precedent:
# the ⏸ icon is already appended outside custom --format).
_updated="—"
_data_age=""
if [[ -f "$cache_file" ]]; then
    _updated=$(date -r "$cache_file" +%H:%M)
    _data_age=$(rel_age $(( $(date +%s) - $(date -r "$cache_file" +%s) )))
fi
_stale_note=""
# Suffix for the freshness footer. The footer always says when the data is
# from; this only adds WHY it is not fresh, in the same words the Omarchy shell
# panel uses.
_stale_suffix=""
if [[ "${transient_stale:-false}" == "true" ]]; then
    _stale_note="  Waiting for network — data from ${_updated}${_data_age:+ (${_data_age})}"
    _stale_suffix="<span foreground='${ORANGE}'> · stale (waiting for network)</span>"
elif [[ -f "$stale_marker" ]]; then
    _stale_note="  Stale — data from ${_updated}${_data_age:+ (${_data_age})}"
    _stale_suffix="<span foreground='${ORANGE}'> · stale (API errors)</span>"
fi

# --- Tooltip ---
if [[ -n "$TOOLTIP_FORMAT" ]]; then
    # Custom tooltip via --tooltip-format
    t=$(apply_format "$TOOLTIP_FORMAT")
    [[ -n "$_stale_note" ]] && t+=$'\n'"<span foreground='${ORANGE}'>${_stale_note}</span>"
else
    # Default rich Pango tooltip — tooltip-specific bars may carry an elapsed marker.
    tip_session_bar=$(display_bar "$session_pct" "$session_elapsed" "$TOOLTIP_PACE_PTS")
    tip_weekly_bar=$(display_bar "$weekly_pct" "$weekly_elapsed" "$TOOLTIP_PACE_PTS")
    s_cd="$s_cd_val"
    w_cd="$w_cd_val"

    NL=$'\n'
    B="<span foreground='${BLUE}'>"
    E="</span>"

    strip_tags() { sed 's/<[^>]*>//g' <<< "$1"; }

    # Right-align a plain value label to a fixed column (width 6 fits "100% ↑").
    _val_pad() { local w=6 n=${#1}; (( n > w )) && w=$n; printf '%*s' $(( w - n )) ''; }

    # Collect all content lines into an array
    lines=()
    _tip_title="Claude ${plan}"
    [[ "$REMAINING" == "true" ]] && _tip_title="${_tip_title} · Remaining"
    lines+=("CENTER<span font_weight='bold' foreground='${BLUE}'>${_tip_title}</span>")
    lines+=("SEP")
    lines+=("")
    lines+=(" <span foreground='${FG}'>  󰔟  Session</span>")
    _lbl_s="$(display_pct "$session_pct")%"
    lines+=("   ${tip_session_bar}  $(_val_pad "$_lbl_s")<span font_weight='bold' foreground='${session_color}'>${_lbl_s}</span>")
    # El pacing vive con el texto que lo explica, no pegado al %: "34% ↓"
    # se lee como si el USO hubiera bajado. Misma forma que el panel.
    lines+=(" <span foreground='${DIM}'>  󰥔  Resets in ${s_cd}</span><span foreground='${DIM}'>  ·  ${session_pace_indicator} ${session_pace_pts}</span>")
    lines+=("")
    lines+=(" <span foreground='${FG}'>  󰃰  Weekly</span>")
    _lbl_w="$(display_pct "$weekly_pct")%"
    lines+=("   ${tip_weekly_bar}  $(_val_pad "$_lbl_w")<span font_weight='bold' foreground='${weekly_color}'>${_lbl_w}</span>")
    # El pacing vive con el texto que lo explica, no pegado al %: "34% ↓"
    # se lee como si el USO hubiera bajado. Misma forma que el panel.
    lines+=(" <span foreground='${DIM}'>  󰥔  Resets in ${w_cd}</span><span foreground='${DIM}'>  ·  ${weekly_pace_indicator} ${weekly_pace_pts}</span>")

    if [[ "$has_sonnet" == "true" ]]; then
        tip_sonnet_bar=$(display_bar "$sonnet_pct" "$sonnet_elapsed" "$TOOLTIP_PACE_PTS")
        sn_cd=$(countdown "$sonnet_reset")
        lines+=("")
        lines+=(" <span foreground='${FG}'>  󱤔  Sonnet only</span>")
        _lbl_n="$(display_pct "$sonnet_pct")%"
        lines+=("   ${tip_sonnet_bar}  $(_val_pad "$_lbl_n")<span font_weight='bold' foreground='${sonnet_color}'>${_lbl_n}</span>")
        lines+=(" <span foreground='${DIM}'>  󰥔  Resets in ${sn_cd}</span><span foreground='${DIM}'>  ·  ${sonnet_pace_indicator} ${sonnet_pace_pts}</span>")
    fi

    # One section per model-scoped limit. Index 0 reuses the cached pacing/
    # countdown behind the {model_*} placeholders so tooltip and placeholders
    # can never disagree within one run; later entries compute inline.
    for _mi in "${!model_pcts[@]}"; do
        _mp="${model_pcts[$_mi]}"
        if (( _mi == 0 )); then
            _melapsed=$model_elapsed _mtip_pace=$_tip_model_pace
            _mcolor=$model_color _mcd=$m_cd_val _mpts=$model_pace_pts _mind=$model_pace_indicator
        else
            _mpace_out=$(calc_pacing "$_mp" "${model_resets[$_mi]}" "$WEEKLY_WINDOW")
            read -r _melapsed _micon _mind _mdiscard <<< "$_mpace_out"
            _mtip_pace="$_micon"
            [[ "$TOOLTIP_PACE_PTS" == "true" ]] && _mtip_pace="$_mind"
            _mpts=$(cut -d' ' -f7-8 <<< "$_mpace_out")
            _mcolor=$(color_for "$_mp")
            _mcd=$(countdown "${model_resets[$_mi]}")
        fi
        _mbar=$(display_bar "$_mp" "$_melapsed" "$TOOLTIP_PACE_PTS")
        lines+=("")
        lines+=(" <span foreground='${FG}'>  󱤔  ${model_names_esc[$_mi]} only</span>")
        _lbl_m="$(display_pct "$_mp")%"
        lines+=("   ${_mbar}  $(_val_pad "$_lbl_m")<span font_weight='bold' foreground='${_mcolor}'>${_lbl_m}</span>")
        lines+=(" <span foreground='${DIM}'>  󰥔  Resets in ${_mcd}</span><span foreground='${DIM}'>  ·  ${_mind} ${_mpts}</span>")
    done

    if [[ "$extra_show" == "true" ]]; then
        lines+=("")
        lines+=("SEP")
        lines+=(" <span foreground='${FG}'>  󰄑  Extra usage</span>")
        if [[ "$extra_balance_known" == "true" ]]; then
            lines+=(" <span foreground='${DIM}'>  󰄑  Spent: ${extra_spent} / ${extra_funded}</span>  <span font_weight='bold' foreground='${extra_color}'>${extra_pct}%</span>")
            lines+=("   ${format_extra_bar}")
            lines+=(" <span foreground='${DIM}'>  󰄰  Available: ${extra_available} · Monthly limit: ${extra_limit}</span>")
        else
            lines+=(" <span foreground='${DIM}'>  󰄑  Spent: ${extra_spent} / —</span>")
            lines+=(" <span foreground='${DIM}'>  󰄰  Available: — · Monthly limit: ${extra_limit}</span>")
        fi
    fi

    # API error info (if stale)
    if [[ -f "$CACHE_DIR/.last_error" ]]; then
        _le_code="" _le_msg=""
        { read -r _le_code || true; read -r _le_msg || true; } < "$CACHE_DIR/.last_error" 2>/dev/null || true
        if [[ -n "$_le_code" ]] && [[ "$_le_code" =~ ^[0-9]+$ ]] && [[ "$_le_code" != "000" ]]; then
            _le_msg=$(pango_escape "$_le_msg")
            if (( _le_code >= 500 )); then
                _err_icon="󰅚" _err_color="$RED"
            else
                _err_icon="󰀪" _err_color="$ORANGE"
            fi
            lines+=("")
            lines+=("SEP")
            _err_line=" <span foreground='${_err_color}'>  ${_err_icon}  HTTP ${_le_code}</span>"
            lines+=("$_err_line")
            if [[ -n "$_le_msg" ]]; then
                _wbuf=""
                for _wword in $_le_msg; do
                    if [[ -z "$_wbuf" ]]; then
                        _wbuf="$_wword"
                    elif (( ${#_wbuf} + 1 + ${#_wword} <= 35 )); then
                        _wbuf+=" $_wword"
                    else
                        lines+=("     <span foreground='${DIM}'>${_wbuf}</span>")
                        _wbuf="$_wword"
                    fi
                done
                [[ -n "$_wbuf" ]] && lines+=("     <span foreground='${DIM}'>${_wbuf}</span>")
            fi
        fi
    fi

    # Footer: the house freshness line — separator rule, clock glyph,
    # "Updated HH:MM", and a "· stale (...)" suffix only when the data is not
    # fresh. Identical shape in the Omarchy shell panel and in every sibling
    # widget, so a reader learns it once. The blank line above the rule is this
    # tooltip's own section rhythm (every section is preceded by one).
    lines+=("")
    lines+=("SEP")
    lines+=(" <span foreground='${DIM}'>  󰅐  Updated ${_updated}</span>${_stale_suffix}")

    # Calculate max width from content
    max_w=0
    for line in "${lines[@]}"; do
        [[ "$line" == "SEP" ]] && continue
        [[ "$line" == CENTER* ]] && line="${line#CENTER}"
        plain=$(strip_tags "$line")
        (( ${#plain} > max_w )) && max_w=${#plain}
    done
    INNER_W=$(( max_w + 1 ))

    pad() {
        local content="$1"
        local plain=$(strip_tags "$content")
        local len=${#plain}
        local need=$(( INNER_W - len ))
        (( need < 0 )) && need=0
        local sp=""
        printf -v sp '%*s' "$need" ''
        printf '%s%s' "$content" "$sp"
    }

    center_pad() {
        local content="$1"
        local plain=$(strip_tags "$content")
        local len=${#plain}
        local total=$(( INNER_W - len ))
        (( total < 0 )) && total=0
        local lp=$(( total / 2 )) rp=$(( total - total / 2 ))
        local ls="" rs=""
        printf -v ls '%*s' "$lp" ''
        printf -v rs '%*s' "$rp" ''
        printf '%s%s%s' "$ls" "$content" "$rs"
    }

    L() { printf '%s' "${B}│${E}$(pad "$1")${B}│${E}"; }
    LC() { printf '%s' "${B}│${E}$(center_pad "$1")${B}│${E}"; }

    # Build separator dynamically
    sep=""
    printf -v sep '%*s' "$(( INNER_W - 2 ))" ''; sep="${sep// /─}"
    sep=" <span foreground='${DIM}'>${sep}</span>"

    border_h=""
    printf -v border_h '%*s' "$INNER_W" ''; border_h="${border_h// /─}"

    # Render tooltip
    if [[ "$FRAME" == "true" ]]; then
        # Framed: draw the box, then pin the whole tooltip to a complete Mono Nerd
        # Font so text, box-drawing and icons share one uniform advance — alignment
        # holds regardless of the user's bar font (needs JetBrainsMono Nerd Font Mono).
        t=""
        t+="${B}╭${border_h}╮${E}${NL}"
        for line in "${lines[@]}"; do
            if [[ "$line" == "SEP" ]]; then
                t+="$(L "$sep")${NL}"
            elif [[ "$line" == CENTER* ]]; then
                t+="$(LC "${line#CENTER}")${NL}"
            else
                t+="$(L "$line")${NL}"
            fi
        done
        t+="${B}╰${border_h}╯${E}"
        _ff=$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/'\''/\&apos;/g' <<< "$FRAME_FONT")
        t="<span font_family='${_ff}'>${t}</span>"
    else
        # Plain (default): no border, no font pin → renders in the user's font.
        # Nothing is aligned to a right edge, so a non-Nerd font never misaligns.
        t=""
        for line in "${lines[@]}"; do
            if [[ "$line" == "SEP" ]]; then
                t+="${sep}${NL}"
            elif [[ "$line" == CENTER* ]]; then
                # Leading space aligns the title with the rule and section headers.
                t+=" ${line#CENTER}${NL}"
            else
                t+="${line}${NL}"
            fi
        done
        t="${t%"$NL"}"
    fi
fi

# Monochrome tooltip: strip color from the finished markup, whichever path
# built it (default, --tooltip-format, framed). Bars, markers, box drawing,
# bold and layout survive; only the hues go.
if [[ "$TOOLTIP_PLAIN" == "true" ]]; then
    t=$(printf '%s' "$t" | decolor)
fi

# --- Output waybar JSON ---
jq -nc --arg text "$bar_text" --arg tooltip "$t" --arg class "$class" \
    '{text:$text, tooltip:$tooltip, class:$class}'
